# 이모트 원본 음원은 올리지 않는다. 저장소에는 tools/pack-emote-audio.mjs로 묶은 audio/emotes/*.bin만 둔다
audio/emotes/*.mp3
audio/emotes/*.wav
audio/emotes/*.m4a
audio/emotes/*.ogg
# 중계 서버(server/relay)의 설치 폴더와 wrangler dev가 만드는 로컬 상태·비밀 값
server/relay/node_modules/
server/relay/.wrangler/
server/relay/.dev.vars
# 운영자 열쇠(전체 공지 서명용, tools/make-notice-key.mjs) 보관 폴더. 비밀 열쇠는 저장소에 올리지 않는다
.secrets/
